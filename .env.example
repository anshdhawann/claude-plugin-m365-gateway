# ─────────────────────────────────────────────
# Claude Plugin M365 Gateway — Environment
# ─────────────────────────────────────────────
# Copy this to .env and fill in your own values.

# LiteLLM config
LITELLM_MASTER_KEY=sk-your-litellm-master-key-here

# ── OpenAI-compatible endpoints (add as many as you need) ──
# Example: OpenCode Go, LM Studio, vLLM, Ollama, etc.
# Format: PROVIDER_BASE_URL / PROVIDER_API_KEY

OPENER_BASE_URL=http://host.docker.internal:8080/v1
OPENER_API_KEY=sk-no-key-required

# Example: Direct Anthropic API
# ANTHROPIC_API_KEY=sk-ant-...

# Example: OpenRouter
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=sk-or-...
