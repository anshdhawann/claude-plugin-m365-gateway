# ──────────────────────────────────────────────────────
# Caddyfile: LiteLLM reverse proxy with CORS
# ──────────────────────────────────────────────────────
# Replace YOUR_DOMAIN with your actual domain.
# Caddy auto-provisions Let's Encrypt TLS.
#
# The add-in taskpane loads from https://pivot.claude.ai, so every
# response (including errors and preflights) needs CORS headers.
# `defer` makes Caddy's values REPLACE LiteLLM's own CORS headers,
# otherwise the browser sees two Access-Control-Allow-Origin values
# and rejects the response.

YOUR_DOMAIN {
    header {
        Access-Control-Allow-Origin "https://pivot.claude.ai"
        Access-Control-Allow-Methods "GET, POST, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization, x-api-key, anthropic-version, anthropic-beta"
        Access-Control-Max-Age "86400"
        Vary "Origin"
        defer
    }

    # CORS preflight: answer here, never forward to LiteLLM
    @preflight method OPTIONS
    handle @preflight {
        respond 204
    }

    handle /health {
        respond "OK" 200
    }

    # Everything else goes to LiteLLM UNCHANGED (path keeps /v1).
    # Do not use handle_path here: it strips /v1, and LiteLLM only
    # serves the Anthropic endpoint at /v1/messages.
    handle {
        reverse_proxy litellm:4000
    }
}
